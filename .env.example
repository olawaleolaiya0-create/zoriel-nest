# Zoriel Nest — environment variables.
#
# Copy this file to .env.local and fill in real values there.
# .env.local is already in .gitignore — never commit real secrets.
#
# Zero-budget architecture: Supabase Free is the only configured
# service (auth, database, and file storage). No Cloudflare R2, no
# paid storage, no payment gateway.

# --- Supabase (auth + database + storage) -------------------------
# Project URL and anon/publishable key: safe to expose to the browser,
# so these use the NEXT_PUBLIC_ prefix on purpose.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key: full database + storage access, bypasses Row
# Level Security entirely. Server-only — used by src/lib/storage and
# src/lib/supabase/server.ts's createAdminClient(). Never prefix this
# with NEXT_PUBLIC_, never send it to the browser, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ----------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Advertising (optional) -----------------------------------------
# Google AdSense publisher ID, e.g. "ca-pub-1234567890123456". Safe to
# expose to the browser — it's how AdSense's own script identifies
# your account, not a secret. Leave blank and no ad script loads at
# all (see src/components/AdSenseScript.tsx) — this is deliberate, so
# the site never shows a broken/empty ad slot before your AdSense
# account is approved.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
